{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testlane:schema:doctor-report:v1",
  "title": "Testlane setup diagnostic report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "version",
    "runtime",
    "ok",
    "exitCode",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "platform"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "ok": {
      "type": "boolean"
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        6
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "code",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "remedy": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      }
    }
  }
}
