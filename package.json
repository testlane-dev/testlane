{
  "name": "@testlane/cli",
  "version": "0.7.0-beta.2",
  "description": "Authenticated verification for coding agents: broker sandbox sessions and run app-owned Playwright workflows with local evidence.",
  "keywords": [
    "agents",
    "coding-agents",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "credentials",
    "credential-broker",
    "keychain",
    "testing",
    "verification",
    "end-to-end-testing",
    "sandbox",
    "playwright",
    "session",
    "cli"
  ],
  "homepage": "https://github.com/testlane-dev/testlane#readme",
  "bugs": {
    "url": "https://github.com/testlane-dev/testlane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testlane-dev/testlane.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "testlane": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "examples/testlane.profiles.json",
    "examples/claude-code",
    "examples/codex",
    "docs/cli.md",
    "docs/doctor.md",
    "docs/project-install.md",
    "docs/quickstart.md",
    "docs/sessions.md",
    "docs/compatibility.md",
    "docs/agent-verification.md",
    "docs/roadmap.md",
    "docs/mobile-testing.md",
    "docs/verification-diagnostics.md",
    "skills/testlane-verify",
    "examples/agent-verification",
    "!examples/agent-verification/tests",
    "!examples/agent-verification/tests/**",
    "examples/verification-demo",
    "!examples/verification-demo/tests",
    "!examples/verification-demo/tests/**",
    "docs/verification",
    "examples/playwright/README.md",
    "examples/playwright/fixtures.mjs",
    "examples/playwright/app.spec.mjs",
    "examples/playwright/playwright.config.mjs",
    "examples/existing-app",
    "!examples/existing-app/tests",
    "!examples/existing-app/tests/**",
    "docs/platforms.md",
    "docs/rotation.md",
    "docs/strategies.md",
    "docs/threat-model.md",
    "docs/upgrading.md",
    "docs/INTEGRATION-*.md",
    "docs/HANDOFF-ROUTE-CONTRACT.md",
    "docs/playbook",
    "docs/workflows",
    "examples/workflows/authenticated-smoke",
    "!examples/workflows/authenticated-smoke/tests",
    "!examples/workflows/authenticated-smoke/tests/**",
    "!examples/workflows/authenticated-smoke/synthetic-fixtures",
    "!examples/workflows/authenticated-smoke/synthetic-fixtures/**",
    "!examples/workflows/authenticated-smoke/node_modules",
    "!examples/workflows/authenticated-smoke/node_modules/**",
    "examples/workflows/feature-acceptance",
    "!examples/workflows/feature-acceptance/tests",
    "!examples/workflows/feature-acceptance/tests/**",
    "!examples/workflows/feature-acceptance/node_modules",
    "!examples/workflows/feature-acceptance/node_modules/**",
    "!examples/workflows/feature-acceptance/real-broker-proof.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:agent-verification": "node --test examples/agent-verification/tests/*.test.mjs",
    "test:verification-demo": "node --test examples/verification-demo/tests/*.test.mjs",
    "dev": "tsx src/cli.ts",
    "check": "npm run typecheck && npm run test",
    "export:public": "node scripts/export-public.mjs",
    "check:clean-room": "node scripts/clean-room.mjs",
    "demo": "npm --prefix examples/demo-app run demo",
    "demo:verification": "node examples/verification-demo/run.mjs",
    "workflow:smoke": "node examples/workflows/authenticated-smoke/run.mjs",
    "test:workflow": "npm --prefix examples/workflows/authenticated-smoke test",
    "workflow:feature": "node examples/workflows/feature-acceptance/run.mjs",
    "test:workflow-feature": "npm --prefix examples/workflows/feature-acceptance test",
    "test:workflow-support": "npm --prefix examples/workflows/test-support test",
    "proof:smoke-real-broker": "node examples/workflows/test-support/smoke-real-broker-proof.mjs",
    "proof:feature-real-broker": "node examples/workflows/feature-acceptance/real-broker-proof.mjs",
    "proof:demo-real-broker": "npm --prefix examples/demo-app run workflow-proof --",
    "prepublishOnly": "npm run typecheck && npm run build",
    "release:check": "npm run typecheck && npm run test && node --test scripts/release-artifact.test.mjs && node scripts/export-public.mjs --check --release",
    "test:playwright": "npm --prefix examples/playwright test",
    "proof:playwright-real-broker": "node examples/playwright/tests/real-broker-proof.mjs",
    "proof:launch-consumer": "node scripts/launch-consumer-proof.mjs",
    "proof:verification-demo": "node scripts/verification-demo-proof.mjs",
    "release:prepare": "node scripts/release-artifact.mjs prepare",
    "release:verify": "node scripts/release-artifact.mjs verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "commander": "^15.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
